@page
@model FREMA.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "Set your password";
}

<div class="card">
    <h1>Set your password</h1>
    <p class="subtitle">
        You signed in with a temporary password. Choose your own to continue.
    </p>

    <form method="post">
        <div asp-validation-summary="All" class="error" role="alert"></div>

        <label asp-for="Input.NewPassword"></label>
        <input asp-for="Input.NewPassword" type="password" autocomplete="new-password" autofocus />

        <label asp-for="Input.ConfirmPassword"></label>
        <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" />

        <p class="hint">
            At least 12 characters, with upper- and lower-case letters, a number and a symbol.
        </p>

        <input type="hidden" asp-for="Input.ReturnUrl" />

        <button type="submit">Set password and continue</button>
    </form>
</div>

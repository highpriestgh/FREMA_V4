@page
@model FREMA.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "Set your password";
}

<header class="form-head">
    <h1>Set your password</h1>
    <p>You signed in with a temporary password. Choose your own to continue.</p>
</header>

<form method="post" data-busy-form novalidate>
    <div asp-validation-summary="All" class="alert" role="alert"></div>

    <div class="field">
        <label asp-for="Input.NewPassword"></label>
        <div class="control has-toggle">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /></svg>
            <input asp-for="Input.NewPassword" type="password" autocomplete="new-password" autofocus placeholder="At least 12 characters" />
            <button type="button" class="reveal" data-reveal="Input_NewPassword" aria-pressed="false" aria-label="Show password" hidden>
                <svg class="icon-show" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z" /><circle cx="12" cy="12" r="3" /></svg>
                <svg class="icon-hide" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3l18 18M10.6 5.1A10.6 10.6 0 0 1 12 5c6.5 0 10 7 10 7a17 17 0 0 1-3.2 4.1M6.6 6.6A17 17 0 0 0 2 12s3.5 7 10 7a9.9 9.9 0 0 0 5.4-1.6M9.9 9.9a3 3 0 0 0 4.2 4.2" /></svg>
            </button>
        </div>
    </div>

    <div class="field">
        <label asp-for="Input.ConfirmPassword"></label>
        <div class="control">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /><path d="M9 12l2 2 4-4" /></svg>
            <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" placeholder="Type it again" />
        </div>
        <p class="caps" data-caps hidden>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 9h-5v6H9v-6H4z" /></svg>
            Caps Lock is on
        </p>
    </div>

    @* Mirrors the password options in Program.cs. The server still enforces them. *@
    <ul class="rules" data-rules="Input_NewPassword" data-confirm="Input_ConfirmPassword" aria-label="Password requirements">
        <li data-rule="length">12 or more characters</li>
        <li data-rule="upper">An upper-case letter</li>
        <li data-rule="lower">A lower-case letter</li>
        <li data-rule="digit">A number</li>
        <li data-rule="symbol">A symbol</li>
        <li data-rule="match">Both entries match</li>
    </ul>

    <input type="hidden" asp-for="Input.ReturnUrl" />

    <button type="submit" class="submit">
        <span class="spinner" aria-hidden="true"></span>
        <span data-busy-label="Saving…">Set password and continue</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </button>
</form>

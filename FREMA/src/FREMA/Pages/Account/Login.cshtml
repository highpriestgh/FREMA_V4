@page
@model FREMA.Pages.Account.LoginModel
@inject FREMA.Infrastructure.Settings.ISettingsService Settings
@{
    var organisation = await Settings.GetAsync();
    ViewData["Title"] = $"Sign in — {organisation.OrganisationName}";
    var logoUrl = FREMA.Features.Settings.SettingsEndpoints.LogoUrl(organisation);
}

<div class="card">
    @if (logoUrl is not null)
    {
        <img src="@logoUrl" alt="" class="logo" />
    }
    <h1>@organisation.OrganisationName</h1>
    <p class="subtitle">File and Records Management</p>

    <form method="post">
        <div asp-validation-summary="All" class="error" role="alert"></div>

        <label asp-for="Input.UserName"></label>
        <input asp-for="Input.UserName" autocomplete="username" autofocus />

        <label asp-for="Input.Password"></label>
        <input asp-for="Input.Password" type="password" autocomplete="current-password" />

        <label class="checkbox">
            <input asp-for="Input.RememberMe" type="checkbox" />
            <span>Remember me</span>
        </label>

        <input type="hidden" asp-for="Input.ReturnUrl" />

        <button type="submit">Sign in</button>
    </form>
</div>
